#!/bin/zsh --no-rcs
set -euo pipefail

PLIST_PATH="/Library/LaunchDaemons/de.twocent.exam.daemon.plist"
LABEL="system/de.twocent.exam.daemon"

if [[ -f "${PLIST_PATH}" ]]; then
  /bin/launchctl bootstrap system "${PLIST_PATH}" 2>/dev/null || true
  /bin/launchctl enable "${LABEL}" 2>/dev/null || true
  /bin/launchctl kickstart -k "${LABEL}" 2>/dev/null || true
fi

exit 0
